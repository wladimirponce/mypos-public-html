# ── LLM — elige un proveedor y rellena su API key ────────────────────────────
LLM_MODEL=claude-opus-4-8
LLM_PROVIDER=anthropic

# Solo la key del proveedor activo es necesaria:
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GOOGLE_API_KEY=...

# ── MyPOS APIs (127.0.0.1 = misma máquina en producción) ─────────────────────
MYPOS_WEB_URL=http://127.0.0.1/api
MYPOS_SERVICE_EMAIL=agente-ia@tuempresa.cl
MYPOS_SERVICE_PASSWORD=...

MYPOS_ADMIN_URL=http://127.0.0.1/admin/api.php
MYPOS_FB_URL=http://127.0.0.1/admin/fb
MYPOS_API_KEY=...

# ── Seguridad del agente ──────────────────────────────────────────────────────
# El frontend y cualquier caller deben enviar: X-Agent-Secret: <este valor>
AGENT_SECRET=cambia-esto-por-un-secreto-largo

# ── Persistencia ──────────────────────────────────────────────────────────────
AGENT_DB=persistence/agent.db

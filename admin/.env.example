# ============================================================
# admin — Variables de entorno
# Copia este archivo a .env y ajusta los valores
# ============================================================

# ── Base de datos ────────────────────────────────────────────
# Producción (www.mypos.cl / cPanel)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=mypos
DB_USER=zylajdcb
DB_PASS=z7MS(7eWy7.8pB
DB_CHARSET=utf8mb4

# Docker local: sobreescribir con:
# DB_HOST=db
# DB_USER=mypos_user
# DB_PASS=mypos_password
# IS_DOCKER=true

# ── Entorno ──────────────────────────────────────────────────
IS_DOCKER=false

# ── IA / Gemini ───────────────────────────────────────────────
# Clave de Google AI Studio (https://aistudio.google.com/app/apikey)
# Si está definida, el parser del Set de Pruebas SII usará Gemini.
# Dejarla vacía usa el parser nativo PHP.
GEMINI_API_KEY=

# ── Agente IA (agent/) ──────────────────────────────────────────
# Usadas por el botón "Generar SQL con IA" del módulo Consultas IA para
# llamar al microservicio agent/ (que ya maneja cuota/cooldown de LLM).
# NO son necesarias si public_html/api/.env ya las define: admin/autoload.php
# carga ese archivo como fuente adicional de entorno automáticamente.
# AGENT_SECRET debe ser EXACTAMENTE igual al configurado en agent/.env.
MYPOS_AGENT_URL=https://www.mypos.cl/agent
AGENT_SECRET=

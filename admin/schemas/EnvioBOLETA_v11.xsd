<?xml version="1.0" encoding="ISO-8859-1"?>
<xs:schema targetNamespace="http://www.sii.cl/SiiDte" xmlns:SiiDte="http://www.sii.cl/SiiDte" xmlns:ds="http://www.w3.org/2000/09/xmldsig#" xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified" attributeFormDefault="unqualified">
	<xs:import namespace="http://www.w3.org/2000/09/xmldsig#" schemaLocation="xmldsignature_v10.xsd"/>
	<!--
	  Modificacion		 : 16 de Abril del  2007.
         Nueva version		: EnvioBOLETA_v11.xsd
         Modificacion 		: 22 de Abril del  2010.
         Nueva version		: EnvioBOLETA_v11.xsd
      -->
	<xs:element name="EnvioBOLETA">
		<xs:annotation>
			<xs:documentation>Envio de Boletas Electronicas</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element name="SetDTE">
					<xs:annotation>
						<xs:documentation>Conjunto de Boletas enviadas</xs:documentation>
					</xs:annotation>
					<xs:complexType>
						<xs:sequence>
							<xs:element name="Caratula">
								<xs:annotation>
									<xs:documentation>Resumen de Informacion Enviada</xs:documentation>
								</xs:annotation>
								<xs:complexType>
									<xs:sequence>
										<xs:element name="RutEmisor">
											<xs:annotation>
												<xs:documentation>RUT Emisor de las Boletas</xs:documentation>
											</xs:annotation>
											<xs:simpleType>
												<xs:restriction base="SiiDte:RUTType"/>
											</xs:simpleType>
										</xs:element>
										<xs:element name="RutEnvia" type="SiiDte:RUTType">
											<xs:annotation>
												<xs:documentation>RUT que envia las Boletas</xs:documentation>
											</xs:annotation>
										</xs:element>
										<xs:element name="RutReceptor" type="SiiDte:RUTType">
											<xs:annotation>
												<xs:documentation>RUT al que se le envian las Boletas</xs:documentation>
											</xs:annotation>
										</xs:element>
										<xs:element name="FchResol" type="xs:date">
											<xs:annotation>
												<xs:documentation>Fecha de Resolucion que Autoriza la Emision de Boletas (AAAA-MM-DD)</xs:documentation>
											</xs:annotation>
										</xs:element>
										<xs:element name="NroResol">
											<xs:annotation>
												<xs:documentation>Numero de Resolucion que Autoriza la Emision de Boletas</xs:documentation>
											</xs:annotation>
											<xs:simpleType>
												<xs:restriction base="xs:nonNegativeInteger">
													<xs:totalDigits value="6"/>
												</xs:restriction>
											</xs:simpleType>
										</xs:element>
										<xs:element name="TmstFirmaEnv" type="xs:dateTime">
											<xs:annotation>
												<xs:documentation>Fecha y Hora de la Firma del Archivo de Envio</xs:documentation>
											</xs:annotation>
										</xs:element>
										<xs:element name="SubTotDTE" maxOccurs="2">
											<xs:annotation>
												<xs:documentation>Subtotales de Boletas Enviadas</xs:documentation>
											</xs:annotation>
											<xs:complexType>
												<xs:sequence>
													<xs:element name="TpoDTE" type="SiiDte:DTEType">
														<xs:annotation>
															<xs:documentation>Tipo de Boleta Enviada</xs:documentation>
														</xs:annotation>
													</xs:element>
													<xs:element name="NroDTE" type="xs:positiveInteger">
														<xs:annotation>
															<xs:documentation>Numero de Boletas Enviadas</xs:documentation>
														</xs:annotation>
													</xs:element>
												</xs:sequence>
											</xs:complexType>
										</xs:element>
									</xs:sequence>
									<xs:attribute name="version" type="xs:decimal" use="required" fixed="1.0"/>
								</xs:complexType>
							</xs:element>
							<xs:element name="DTE" type="SiiDte:BOLETADefType" maxOccurs="unbounded">
								<xs:annotation>
									<xs:documentation>Boletas Electronicas Enviadas</xs:documentation>
								</xs:annotation>
							</xs:element>
						</xs:sequence>
						<xs:attribute name="ID" type="xs:ID" use="required"/>
					</xs:complexType>
				</xs:element>
				<xs:element ref="ds:Signature"/>
			</xs:sequence>
			<xs:attribute name="version" type="xs:decimal" use="required" fixed="1.0"/>
		</xs:complexType>
	</xs:element>
	<xs:complexType name="BOLETADefType">
		<xs:annotation>
			<xs:documentation>Boleta Electronica</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Documento">
				<xs:annotation>
					<xs:documentation>Informacion Tributaria de la Boleta</xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:sequence>
						<xs:element name="Encabezado">
							<xs:annotation>
								<xs:documentation>Identificacion y Totales del Documento</xs:documentation>
							</xs:annotation>
							<xs:complexType>
								<xs:sequence>
									<xs:element name="IdDoc">
										<xs:annotation>
											<xs:documentation>Identificacion del DTE</xs:documentation>
										</xs:annotation>
										<xs:complexType>
											<xs:sequence>
												<xs:element name="TipoDTE" type="SiiDte:DTEType">
													<xs:annotation>
														<xs:documentation>Tipo de Boleta</xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="Folio" type="SiiDte:FolioType">
													<xs:annotation>
														<xs:documentation>Folio del Documento Electronico</xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="FchEmis" type="xs:date">
													<xs:annotation>
														<xs:documentation>Fecha Emision Contable del DTE (AAAA-MM-DD)</xs:documentation>
													</xs:annotation>
												</xs:element>
												<xs:element name="IndServicio">
													<xs:annotation>
														<xs:documentation>Indica el Tipo de Transaccion</xs:documentation>
													</xs:annotation>
													<xs:simpleType>
														<xs:restriction base="xs:positiveInteger">
															<xs:enumeration value="1"/>
															<xs:enumeration value="2"/>
															<xs:enumeration value="3"/>
															<xs:enumeration value="4"/>
														</xs:restriction>
													</xs:simpleType>
												</xs:element>
												<xs:element name="IndMntNeto" minOccurs="0">
													<xs:annotation>
														<xs:documentation>Indica el Uso de Montos Netos en Detalle</xs:documentation>
													</xs:annotation>
													<xs:simpleType>
														<xs:restriction base="xs:integer">
															<xs:enumeration value="2"/>
														</xs:restriction>
													</xs:simpleType>
												</xs:element>
												<xs:element name="PeriodoDesde" type="xs:date" minOccurs="0"/>
												<xs:element name="PeriodoHasta" type="xs:date" minOccurs="0"/>
												<xs:element name="FchVenc" type="xs:date" minOccurs="0"/>
											</xs:sequence>
										</xs:complexType>
									</xs:element>
									<xs:element name="Emisor">
										<xs:annotation>
											<xs:documentation>Datos del Emisor</xs:documentation>
										</xs:annotation>
										<xs:complexType>
											<xs:sequence>
												<xs:element name="RUTEmisor" type="SiiDte:RUTType"/>
												<xs:element name="RznSocEmisor" minOccurs="0">
													<xs:simpleType>
														<xs:restriction base="xs:string">
															<xs:maxLength value="100"/>
														</xs:restriction>
													</xs:simpleType>
												</xs:element>
												<xs:element name="GiroEmisor" minOccurs="0">
													<xs:simpleType>
														<xs:restriction base="xs:string">
															<xs:maxLength value="80"/>
														</xs:restriction>
													</xs:simpleType>
												</xs:element>
												<xs:element name="CdgSIISucur" minOccurs="0">
													<xs:simpleType>
														<xs:restriction base="xs:positiveInteger">
															<xs:totalDigits value="9"/>
														</xs:restriction>
													</xs:simpleType>
												</xs:element>
												<xs:element name="DirOrigen" minOccurs="0">
													<xs:simpleType>
														<xs:restriction base="xs:string">
															<xs:maxLength value="70"/>
														</xs:restriction>
													</xs:simpleType>
												</xs:element>
												<xs:element name="CmnaOrigen" minOccurs="0">
													<xs:simpleType>
														<xs:restriction base="xs:string">
															<xs:maxLength value="20"/>
														</xs:restriction>
													</xs:simpleType>
												</xs:element>
												<xs:element name="CiudadOrigen" minOccurs="0">
													<xs:simpleType>
														<xs:restriction base="xs:string">
															<xs:maxLength value="20"/>
														</xs:restriction>
													</xs:simpleType>
												</xs:element>
											</xs:sequence>
										</xs:complexType>
									</xs:element>
									<xs:element name="Receptor">
										<xs:annotation>
											<xs:documentation>Datos del Receptor</xs:documentation>
										</xs:annotation>
										<xs:complexType>
											<xs:sequence>
												<xs:element name="RUTRecep" type="SiiDte:RUTType"/>
												<xs:element name="CdgIntRecep" minOccurs="0">
													<xs:simpleType>
														<xs:restriction base="xs:string">
															<xs:maxLength value="20"/>
														</xs:restriction>
													</xs:simpleType>
												</xs:element>
												<xs:element name="RznSocRecep" minOccurs="0">
													<xs:simpleType>
														<xs:restriction base="xs:string">
															<xs:maxLength value="100"/>
														</xs:restriction>
													</xs:simpleType>
												</xs:element>
												<xs:element name="Contacto" minOccurs="0">
													<xs:simpleType>
														<xs:restriction base="xs:string">
															<xs:maxLength value="80"/>
														</xs:restriction>
													</xs:simpleType>
												</xs:element>
												<xs:element name="DirRecep" minOccurs="0">
													<xs:simpleType>
														<xs:restriction base="xs:string">
															<xs:maxLength value="70"/>
														</xs:restriction>
													</xs:simpleType>
												</xs:element>
												<xs:element name="CmnaRecep" minOccurs="0">
													<xs:simpleType>
														<xs:restriction base="xs:string">
															<xs:maxLength value="20"/>
														</xs:restriction>
													</xs:simpleType>
												</xs:element>
												<xs:element name="CiudadRecep" minOccurs="0">
													<xs:simpleType>
														<xs:restriction base="xs:string">
															<xs:maxLength value="20"/>
														</xs:restriction>
													</xs:simpleType>
												</xs:element>
												<xs:element name="DirPostal" minOccurs="0">
													<xs:simpleType>
														<xs:restriction base="xs:string">
															<xs:maxLength value="70"/>
														</xs:restriction>
													</xs:simpleType>
												</xs:element>
												<xs:element name="CmnaPostal" minOccurs="0">
													<xs:simpleType>
														<xs:restriction base="xs:string">
															<xs:maxLength value="20"/>
														</xs:restriction>
													</xs:simpleType>
												</xs:element>
												<xs:element name="CiudadPostal" minOccurs="0">
													<xs:simpleType>
														<xs:restriction base="xs:string">
															<xs:maxLength value="20"/>
														</xs:restriction>
													</xs:simpleType>
												</xs:element>
											</xs:sequence>
										</xs:complexType>
									</xs:element>
									<xs:element name="Totales">
										<xs:annotation>
											<xs:documentation>Montos Totales del DTE</xs:documentation>
										</xs:annotation>
										<xs:complexType>
											<xs:sequence>
												<xs:element name="MntNeto" type="SiiDte:MontoType" minOccurs="0"/>
												<xs:element name="MntExe" type="SiiDte:MontoType" minOccurs="0"/>
												<xs:element name="IVA" type="SiiDte:MntImpType" minOccurs="0"/>
												<xs:element name="MntTotal" type="SiiDte:MontoType"/>
												<xs:element name="MontoNF" type="SiiDte:ValorType" minOccurs="0"/>
												<xs:element name="TotalPeriodo" type="SiiDte:MontoType" minOccurs="0"/>
												<xs:element name="SaldoAnterior" type="SiiDte:ValorType" minOccurs="0"/>
												<xs:element name="VlrPagar" type="SiiDte:ValorType" minOccurs="0"/>
											</xs:sequence>
										</xs:complexType>
									</xs:element>
								</xs:sequence>
							</xs:complexType>
						</xs:element>
						<xs:element name="Detalle" maxOccurs="1000">
							<xs:annotation>
								<xs:documentation>Detalle de Itemes del Documento</xs:documentation>
							</xs:annotation>
							<xs:complexType>
								<xs:sequence>
									<xs:element name="NroLinDet" type="xs:positiveInteger"/>
									<xs:element name="CdgItem" minOccurs="0" maxOccurs="5">
										<xs:complexType>
											<xs:sequence>
												<xs:element name="TpoCodigo">
													<xs:simpleType>
														<xs:restriction base="xs:string">
															<xs:maxLength value="10"/>
														</xs:restriction>
													</xs:simpleType>
												</xs:element>
												<xs:element name="VlrCodigo">
													<xs:simpleType>
														<xs:restriction base="xs:string">
															<xs:maxLength value="35"/>
														</xs:restriction>
													</xs:simpleType>
												</xs:element>
											</xs:sequence>
										</xs:complexType>
									</xs:element>
									<xs:element name="IndExe" minOccurs="0">
										<xs:simpleType>
											<xs:restriction base="xs:positiveInteger">
												<xs:enumeration value="1"/>
												<xs:enumeration value="2"/>
												<xs:enumeration value="6"/>
											</xs:restriction>
										</xs:simpleType>
									</xs:element>
									<xs:element name="NmbItem">
										<xs:simpleType>
											<xs:restriction base="xs:string">
												<xs:maxLength value="80"/>
											</xs:restriction>
										</xs:simpleType>
									</xs:element>
									<xs:element name="DscItem" minOccurs="0">
										<xs:simpleType>
											<xs:restriction base="xs:string">
												<xs:maxLength value="1000"/>
											</xs:restriction>
										</xs:simpleType>
									</xs:element>
									<xs:element name="QtyItem" type="SiiDte:Dec5Type" minOccurs="0"/>
									<xs:element name="UnmdItem" minOccurs="0">
										<xs:simpleType>
											<xs:restriction base="xs:string">
												<xs:maxLength value="4"/>
											</xs:restriction>
										</xs:simpleType>
									</xs:element>
									<xs:element name="PrcItem" type="SiiDte:Dec5Type" minOccurs="0"/>
									<xs:element name="DescuentoPct" minOccurs="0">
										<xs:simpleType>
											<xs:restriction base="SiiDte:PctType">
												<xs:minInclusive value="0.00"/>
												<xs:maxInclusive value="100.00"/>
											</xs:restriction>
										</xs:simpleType>
									</xs:element>
									<xs:element name="DescuentoMonto" minOccurs="0">
										<xs:simpleType>
											<xs:restriction base="xs:nonNegativeInteger">
												<xs:totalDigits value="18"/>
											</xs:restriction>
										</xs:simpleType>
									</xs:element>
									<xs:element name="RecargoPct" minOccurs="0">
										<xs:simpleType>
											<xs:restriction base="SiiDte:PctType">
												<xs:maxInclusive value="100.00"/>
												<xs:minInclusive value="0.00"/>
											</xs:restriction>
										</xs:simpleType>
									</xs:element>
									<xs:element name="RecargoMonto" minOccurs="0">
										<xs:simpleType>
											<xs:restriction base="xs:nonNegativeInteger">
												<xs:totalDigits value="18"/>
											</xs:restriction>
										</xs:simpleType>
									</xs:element>
									<xs:element name="MontoItem" type="SiiDte:MontoType"/>
								</xs:sequence>
							</xs:complexType>
						</xs:element>
						<xs:element name="SubTotInfo" minOccurs="0" maxOccurs="20">
							<xs:complexType>
								<xs:sequence>
									<xs:element name="NroSTI">
										<xs:simpleType>
											<xs:restriction base="xs:positiveInteger">
												<xs:maxInclusive value="99"/>
											</xs:restriction>
										</xs:simpleType>
									</xs:element>
									<xs:element name="GlosaSTI" minOccurs="0">
										<xs:simpleType>
											<xs:restriction base="xs:string">
												<xs:maxLength value="80"/>
											</xs:restriction>
										</xs:simpleType>
									</xs:element>
									<xs:element name="OrdenSTI">
										<xs:simpleType>
											<xs:restriction base="xs:positiveInteger">
												<xs:maxInclusive value="99"/>
											</xs:restriction>
										</xs:simpleType>
									</xs:element>
									<xs:element name="SubTotNetoSTI" type="SiiDte:Dec1Type" minOccurs="0"/>
									<xs:element name="SubTotIVASTI" type="SiiDte:Dec1Type" minOccurs="0"/>
									<xs:element name="SubTotAdicSTI" type="SiiDte:Dec1Type" minOccurs="0"/>
									<xs:element name="SubTotExeSTI" type="SiiDte:Dec1Type" minOccurs="0"/>
									<xs:element name="ValSubtotSTI" type="SiiDte:Dec1Type" minOccurs="0"/>
									<xs:element name="LineasDeta" minOccurs="0" maxOccurs="60">
										<xs:simpleType>
											<xs:restriction base="xs:positiveInteger">
												<xs:maxInclusive value="60"/>
											</xs:restriction>
										</xs:simpleType>
									</xs:element>
								</xs:sequence>
							</xs:complexType>
						</xs:element>
						<xs:element name="DscRcgGlobal" minOccurs="0" maxOccurs="20">
							<xs:complexType>
								<xs:sequence>
									<xs:element name="NroLinDR">
										<xs:simpleType>
											<xs:restriction base="xs:positiveInteger">
												<xs:maxInclusive value="99"/>
												<xs:minInclusive value="1"/>
											</xs:restriction>
										</xs:simpleType>
									</xs:element>
									<xs:element name="TpoMov">
										<xs:simpleType>
											<xs:restriction base="xs:string">
												<xs:enumeration value="D"/>
												<xs:enumeration value="R"/>
											</xs:restriction>
										</xs:simpleType>
									</xs:element>
									<xs:element name="GlosaDR" minOccurs="0">
										<xs:simpleType>
											<xs:restriction base="xs:string">
												<xs:maxLength value="45"/>
											</xs:restriction>
										</xs:simpleType>
									</xs:element>
									<xs:element name="TpoValor">
										<xs:simpleType>
											<xs:restriction base="xs:string">
												<xs:enumeration value="%"/>
												<xs:enumeration value="$"/>
											</xs:restriction>
										</xs:simpleType>
									</xs:element>
									<xs:element name="ValorDR" type="SiiDte:Dec1Type"/>
									<xs:element name="IndExeDR" minOccurs="0">
										<xs:simpleType>
											<xs:restriction base="xs:positiveInteger">
												<xs:enumeration value="1"/>
												<xs:enumeration value="2"/>
											</xs:restriction>
										</xs:simpleType>
									</xs:element>
								</xs:sequence>
							</xs:complexType>
						</xs:element>
						<xs:element name="Referencia" minOccurs="0" maxOccurs="40">
							<xs:complexType>
								<xs:sequence>
									<xs:element name="NroLinRef">
										<xs:simpleType>
											<xs:restriction base="xs:positiveInteger">
												<xs:maxInclusive value="40"/>
											</xs:restriction>
										</xs:simpleType>
									</xs:element>
									<xs:element name="CodRef" minOccurs="0">
										<xs:simpleType>
											<xs:restriction base="xs:string">
												<xs:maxLength value="18"/>
											</xs:restriction>
										</xs:simpleType>
									</xs:element>
									<xs:element name="RazonRef" minOccurs="0">
										<xs:simpleType>
											<xs:restriction base="xs:string">
												<xs:maxLength value="90"/>
											</xs:restriction>
										</xs:simpleType>
									</xs:element>
								</xs:sequence>
							</xs:complexType>
						</xs:element>
						<xs:element name="TED">
							<xs:complexType>
								<xs:sequence>
									<xs:element name="DD">
										<xs:complexType>
											<xs:sequence>
												<xs:element name="RE" type="SiiDte:RUTType"/>
												<xs:element name="TD" type="SiiDte:DTEType"/>
												<xs:element name="F" type="SiiDte:FolioType"/>
												<xs:element name="FE" type="xs:date"/>
												<xs:element name="RR" type="SiiDte:RUTType"/>
												<xs:element name="RSR">
													<xs:simpleType>
														<xs:restriction base="xs:string">
															<xs:maxLength value="40"/>
														</xs:restriction>
													</xs:simpleType>
												</xs:element>
												<xs:element name="MNT" type="xs:unsignedLong"/>
												<xs:element name="IT1">
													<xs:simpleType>
														<xs:restriction base="xs:string">
															<xs:maxLength value="40"/>
														</xs:restriction>
													</xs:simpleType>
												</xs:element>
												<xs:element name="CAF">
													<xs:complexType>
														<xs:sequence>
															<xs:element name="DA">
																<xs:complexType>
																	<xs:sequence>
																		<xs:element name="RE" type="SiiDte:RUTType"/>
																		<xs:element name="RS">
																			<xs:simpleType>
																				<xs:restriction base="xs:string">
																					<xs:maxLength value="40"/>
																				</xs:restriction>
																			</xs:simpleType>
																		</xs:element>
																		<xs:element name="TD" type="SiiDte:DTEType"/>
																		<xs:element name="RNG">
																			<xs:complexType>
																				<xs:sequence>
																					<xs:element name="D" type="SiiDte:FolioType"/>

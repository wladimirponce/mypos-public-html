# Entorno de Produccion para MyPOS Backend
# Copiar a .env en la raiz del backend en el servidor productivo

APP_ENV=production
APP_DEBUG=false
APP_URL=https://www.mypos.cl/api
API_BASE_URL=https://www.mypos.cl
FRONTEND_URL=https://www.mypos.cl

# CORS
# En produccion es critico NO USAR *. Declarar dominios permitidos sin trailing slash
CORS_ALLOWED_ORIGINS=https://www.mypos.cl,https://mypos.cl

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_LOGIN_MAX_REQUESTS=10
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60

# Archivos y Logs
# Usar rutas absolutas o relativas desde el DOCUMENT_ROOT logico. 
# Si esta sobre cPanel, dejar estos relativos deberia escribir en el directorio 'storage' fuera del root publico.
STORAGE_PATH=storage
LOG_PATH=storage/logs/app.log
UPLOAD_MAX_MB=20
LOG_LEVEL=warning

# Certificados SII
# Opcional. Si el hosting no encuentra openssl automaticamente, indicar la ruta absoluta.
# Ejemplos comunes: /usr/bin/openssl, /usr/local/bin/openssl
OPENSSL_BIN=

# Base de datos
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mypos_prod
DB_USERNAME=usuario_bd
DB_PASSWORD=
DB_ROOT_PASSWORD=

# JWT
# Generar un string criptografico fuerte (Ej: php -r "echo bin2hex(random_bytes(32));")
JWT_SECRET=
JWT_TTL_MINUTES=1440

# Sesion SaaS revocable. Activar solo despues de aplicar 076_auth_sessions.sql
AUTH_REFRESH_ENABLED=false
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=true

# Pagos SaaS
# FLOW_MODE: sandbox o production
FLOW_MODE=production
FLOW_API_KEY=
FLOW_SECRET_KEY=
# Empresas sujetas a cobro mensual por Flow, en formato empresa_id:monto_clp.
# Permite varias reglas separadas por coma, por ejemplo: 10:500,12:1500
# El monto aqui es solo el valor por defecto: si la suscripcion tiene
# precio_especial_clp (columna "Monto mensual" del panel admin), ese manda.
FLOW_MONTHLY_CHARGE_RULES=10:500

# MyPOS Cerca / Mercado Pago Checkout. Las credenciales de cada comercio se
# almacenan cifradas en BD; estas tres variables corresponden a la app marketplace.
MP_MARKETPLACE_CLIENT_ID=
MP_MARKETPLACE_CLIENT_SECRET=
MP_MARKETPLACE_REDIRECT_URI=https://api.mypos.cl/api/public/cerca/oauth/mercadopago/callback

# PAYPAL_MODE: sandbox o production
PAYPAL_MODE=production
PAYPAL_CLIENT_ID=
PAYPAL_SECRET_KEY=

# DTE
DTE_SISTEMA_PATH=
DTE_MODE_DEFAULT=SIMULADO
DTE_REAL_ENABLED=false
# Endpoint de la API REST del admin DTE (ej: https://www.mypos.cl/admin/api.php)
DTE_ENDPOINT_HTTP=
# Preferir clave por empresa: DTE_ADMIN_API_KEY_1=...
DTE_ADMIN_API_KEY=

# Gemini (IA)
# Si se desea habilitar, ingresar clave secreta aqui (NO en repositorios publicos ni en el frontend)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta

# Agente IA conversacional
# MYPOS_AGENT_URL apunta al microservicio Python instalado en cPanel.
# AGENT_SECRET debe ser exactamente igual al AGENT_SECRET configurado en la app Python.
MYPOS_AGENT_URL=https://www.mypos.cl/agent
AGENT_SECRET=

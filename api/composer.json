{
  "name": "agentika/mypos-backend",
  "description": "Backend API REST para MyPOS - Administrador Punto de Venta",
  "license": "proprietary",
  "type": "project",
  "autoload": {
    "psr-4": {
      "Mypos\\": "src/"
    }
  },
  "require": {
    "php": "^8.3",
    "firebase/php-jwt": "^7.1",
    "vlucas/phpdotenv": "^5.6",
    "phpmailer/phpmailer": "^7.1",
    "dompdf/dompdf": "^3.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0",
    "phpstan/phpstan": "^1.12",
    "friendsofphp/php-cs-fixer": "^3.64"
  },
  "scripts": {
    "test": "@php vendor/bin/phpunit --configuration phpunit.xml.dist",
    "test:unit": "@php vendor/bin/phpunit --configuration phpunit.xml.dist --testsuite unit",
    "test:integration": "@php vendor/bin/phpunit --configuration phpunit.xml.dist --testsuite integration",
    "test:smoke": "php ../tests/run_smoke_tests.php",
    "check:env": "php ../scripts/check_env.php",
    "lint": "php -l public/index.php",
    "analyse": "@php vendor/bin/phpstan analyse --configuration phpstan.neon",
    "cs-fix": "@php vendor/bin/php-cs-fixer fix src"
  }
}

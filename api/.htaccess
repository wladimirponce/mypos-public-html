# ── Seguridad: bloquear acceso directo a archivos sensibles ─────────────
<FilesMatch "^\.(env|gitignore|gitkeep)$|^(composer\.(json|lock)|Dockerfile|apache\.conf|php\.ini)$">
    Require all denied
</FilesMatch>

RewriteEngine On

# Bloquear acceso directo a directorios internos
RewriteRule ^(src|vendor|storage|database)(/|$) - [F,L]

# JWT: preservar el header Authorization para que PHP pueda leerlo
SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1

# PFX antiguos del SII pueden venir cifrados con RC2/3DES.
# OpenSSL 3 requiere activar provider legacy para validarlos.
SetEnv OPENSSL_CONF "/home/zylajdcb/public_html/api/openssl-legacy.cnf"

# Descarga del instalador del print server (sin autenticación)
RewriteRule ^descargar-print-server\.php$ public/descargar-print-server.php [L]
RewriteRule ^public/descargar-print-server\.php$ public/descargar-print-server.php [L]

# Reenviar todas las demás peticiones al router PHP
RewriteRule ^ public/index.php [QSA,L]
